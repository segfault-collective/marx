---
import { getCollection, getEntries } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import PostComponent from '../components/content/Post.astro';
import { linkStyles } from '../components/typography';

const allBlogPostEntries = await getCollection('blog');
const posts = await Promise.all(
  allBlogPostEntries.map(async (post) => ({
    ...post.data,
    marginalia: (await getEntries(post.data.marginalia)).map(
      (entry) => entry.data
    ),
  }))
);

posts.sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime());

const heroParagraphStyles =
  'text-black/85 dark:text-white/85 text-base/6 sm:text-lg/7 md:text-xl/8 sm:text-justify m-0 font-light';
---

<Layout title="Ομάδα Ανάγνωσης Κεφαλαίου Μαρξ - Φάμπρικα Υφανέτ">
  <div class="flex flex-col align-center px-6 gap-10 sm:gap-30 md:gap-40">
    <div class="flex flex-auto flex-col justify-around">
      <div class="flex flex-col py-0 gap-6">
        <p class={heroParagraphStyles}>
          Υλικό και συζητήσεις της ομάδας ανάγνωσης του Κεφαλαίου του Marx που
          στεγάστηκε στη{' '}
          <a class={linkStyles} href="https://yfanet.espivblogs.net">
            Φάμπρικα Υφανέτ
          </a>{' '}
          από το 2023 έως το 2025.
        </p>
      </div>
    </div>
  </div>

  <div class="px-6">
    <hr class="my-10 sm:my-4 opacity-10 text-black dark:text-white" />
  </div>

  <div class="flex-auto flex flex-col align-stretch sm:align-start gap-6 md:gap-8 px-6">
    <div class="flex flex-col gap-4">
      <h1 class="text-black/90 dark:text-white/90 text-center sm:text-left text-4xl sm:text-5xl md:text-6xl font-serif font-bold">
        Υλικό Συναντήσεων
      </h1>
    </div>
    <div class="flex flex-col gap-8">
      {posts.length > 0 && (
        <div class="flex flex-col gap-8">
          {posts.map((post) => (
            <PostComponent post={post} size="normal" />
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
